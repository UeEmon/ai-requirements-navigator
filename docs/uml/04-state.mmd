stateDiagram-v2
    [*] --> ヒアリング中 : プロジェクト作成
    state ヒアリング中 {
        [*] --> 目的整理
        目的整理 --> 利用者定義
        利用者定義 --> 業務フロー
        業務フロー --> 機能要件
        機能要件 --> 非機能要件
        非機能要件 --> 制約条件
        制約条件 --> [*]
    }
    ヒアリング中 --> 完了 : phaseKey = done
    完了 --> レビュー中 : 仕様書を出力
    レビュー中 --> ヒアリング中 : 差戻し
    レビュー中 --> 確定 : 承認
    確定 --> ヒアリング中 : 変更要求（新しい版）
    確定 --> [*]

    state 生成ラウンド {
        [*] --> 生成中
        生成中 --> 評価中 : 1案以上取得
        生成中 --> 失敗 : 全AI失敗
        評価中 --> 選択待ち
        選択待ち --> 決定済み
        決定済み --> [*]
    }
