# =====================================================================
# 環境変数。ローカルDockerとAWSで同じイメージを使い、ここだけを切り替える。
# AWS では deploy/aws（CDK）がこれらを ECS タスク定義に設定する。
# =====================================================================

# ---- 実行モード ----
# development: 開発用認証（ヘッダー）・模擬AIを許可 / production: OIDC必須・模擬AI無効
NODE_ENV=development
PORT=8787

# ---- データ保存 ----
# postgres（推奨） / memory（お試し。再起動で消える）
STORE=postgres
DATABASE_URL=postgres://arn:arn@localhost:5432/arn
DATABASE_SSL=false
MIGRATE_ON_START=true

# ---- APIキーの暗号化（組織ごとに管理者が登録するキー） ----
# local: MASTER_KEY による AES-256-GCM / aws-kms: AWS KMS
KEY_ENCRYPTION=local
# 32バイトをBase64で。生成: npm run gen:key
MASTER_KEY=
# KEY_ENCRYPTION=aws-kms のとき
KMS_KEY_ID=
AWS_REGION=ap-northeast-1

# ---- 成果物（仕様書・図）の保存先 ----
# local: ローカルディレクトリ（Dockerボリューム） / s3: Amazon S3
STORAGE=local
STORAGE_DIR=./data/artifacts
S3_BUCKET=

# ---- 認証 ----
# dev: ヘッダー（x-org-id / x-role）で利用者を名乗る。開発専用
# oidc: Amazon Cognito または Keycloak のアクセストークンを検証
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ORG_CLAIM=custom:org_id
OIDC_ROLE_CLAIM=cognito:groups
# 最初の組織を作るためのトークン（POST /api/orgs に x-bootstrap-token で渡す）
BOOTSTRAP_TOKEN=

# ---- AI ----
# 模擬AI（APIキーなしで動作確認）。本番では false
ALLOW_MOCK_PROVIDER=true
AI_TIMEOUT_MS=90000

# 注意: Claude / OpenAI / Gemini のAPIキーはここには書きません。
# 各組織の管理者が画面（または POST /api/orgs/:orgId/providers）から登録し、暗号化して保存されます。
