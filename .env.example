# =====================================================================
# 環境変数。ローカルDockerとAWSで同じイメージを使い、ここだけを切り替える。
# AWS では deploy/aws（CDK）がこれらを ECS タスク定義に設定する。
# =====================================================================

# ---- Docker Compose（docker-compose.yml）で使う値 ----
# 画面のポート（8787 が使われているときに変える）と、接続を受け付けるアドレス。
# 127.0.0.1 はこのPCからだけ。ほかのPCにも公開するのは AUTH_MODE=oidc のときだけにする
ARN_PORT=8787
ARN_BIND=127.0.0.1
# PostgreSQL のポート（このPCにほかの PostgreSQL があるときに変える）
DB_PORT=5432
# 注意: Docker Compose では DATABASE_URL・STORAGE_DIR などコンテナの中の場所は docker-compose.yml が決めます

# ---- 実行モード ----
# development: 開発用認証（ヘッダー）・模擬AIを許可 / production: OIDC必須・模擬AI無効
NODE_ENV=development
PORT=8787

# ---- データ保存 ----
# postgres（推奨） / memory（お試し。再起動で消える）
STORE=postgres
DATABASE_URL=postgres://arn:arn@localhost:5432/arn
DATABASE_SSL=false
MIGRATE_ON_START=true

# ---- APIキーの暗号化（組織ごとに管理者が登録するキー） ----
# local: MASTER_KEY による AES-256-GCM / aws-kms: AWS KMS
KEY_ENCRYPTION=local
# 32バイトをBase64で。生成: npm run gen:key
MASTER_KEY=
# KEY_ENCRYPTION=aws-kms のとき
KMS_KEY_ID=
AWS_REGION=ap-northeast-1

# ---- 成果物（仕様書・図）の保存先 ----
# local: ローカルディレクトリ（Dockerボリューム） / s3: Amazon S3
STORAGE=local
STORAGE_DIR=./data/artifacts
S3_BUCKET=

# ---- 認証 ----
# dev: ヘッダー（x-org-id / x-role）で利用者を名乗る。開発専用
# oidc: Amazon Cognito または Keycloak のアクセストークンを検証
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ORG_CLAIM=custom:org_id
OIDC_ROLE_CLAIM=cognito:groups
# ログイン画面（認可コード＋PKCE）。設定するとログインボタンが出る
OIDC_CLIENT_ID=
# 機密クライアントの場合のみ（ブラウザには渡らない）
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# discovery に end_session_endpoint がないとき（Cognito など）のログアウト先
OIDC_LOGOUT_URL=
# Docker の Keycloak を使う場合: コンテナ内から見た設定のURL
#   OIDC_ISSUER=http://localhost:8080/realms/arn
#   OIDC_DISCOVERY_URL=http://keycloak:8080/realms/arn/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# 最初の組織を作るためのトークン（POST /api/orgs に x-bootstrap-token で渡す）
BOOTSTRAP_TOKEN=

# ---- AI ----
# 模擬AI（APIキーなしで動作確認）。本番では false
ALLOW_MOCK_PROVIDER=true
AI_TIMEOUT_MS=90000
# 月間トークン上限の「月」を数えるタイムゾーン
USAGE_TIMEZONE=Asia/Tokyo
# 同時に実行するAI処理（ジョブ）の数（コンテナ1台あたり）
JOB_CONCURRENCY=4

# ---- 開発・テストのツールとの連携（MCP・外部連携API・Webhook） ----
# 外から見たこのサーバーのURL。開発用パッケージ（AGENTS.md・.mcp.json）に書く。省略時はリクエストから作る
# PUBLIC_URL=https://arn.example.com
# Webhook の送り先に社内（プライベート）アドレスと http を許す。ローカルの Docker で社内のCIに送るときだけ true
WEBHOOK_ALLOW_PRIVATE=false

# ---- 監査ログ ----
AUDIT_RETENTION_DAYS=365

# 注意: Claude / OpenAI / Gemini のAPIキーはここには書きません。
# 各組織の管理者が画面（または POST /api/orgs/:orgId/providers）から登録し、暗号化して保存されます。
